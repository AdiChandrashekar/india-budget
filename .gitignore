# with their sha256, so they are reproducible rather than committed.
data/raw/

__pycache__/
*.pyc
.venv/
node_modules/
.DS_Store
Thumbs.db
*.tmp
data/processed/union_pdf_cache/

# The PDF-era extraction before it is merged into union_demands.csv. It is an
# intermediate: regenerable with scripts/parse_union_pdf.py from the cached
# raw PDFs, 32 MB, and nothing reads it. The merged long table is the archive
# worth keeping, and the site reads only data/union.json.
data/processed/union_demands_pdf.csv
